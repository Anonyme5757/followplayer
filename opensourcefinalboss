-- ===== LOGIQUE DU SLIDER =====
local dragging = false

local function updateSlider(value)
	value = math.clamp(value, 0, maxOffset)
	currentOffset = value

	local percent = value / maxOffset
	sliderFill.Size = UDim2.new(percent, 0, 1, 0)
	sliderButton.Position = UDim2.new(percent, -8, 0.5, -8)
	sliderLabel.Text = "Décalage : " .. string.format("%.1f", value)
end

sliderButton.MouseButton1Down:Connect(function()
	dragging = true
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local mousePos = UserInputService:GetMouseLocation()
		local backPos = sliderBack.AbsolutePosition
		local backSize = sliderBack.AbsoluteSize

		local relative = (mousePos.X - backPos.X) / backSize.X
		relative = math.clamp(relative, 0, 1)

		updateSlider(relative * maxOffset)
	end
end)

-- Initialise le slider à 0
updateSlider(0)

-- ===== FONCTIONS SUIVI =====
local function stopFollowing()
	isFollowing = false
	targetPlayer = nil
	if connection then
		connection:Disconnect()
		connection = nil
	end
	followButton.Text = "Suivre"
	followButton.BackgroundColor3 = Color3.fromRGB(0, 140, 255)
end

local function startFollowing(name)
	targetPlayer = nil
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer and string.find(string.lower(plr.Name), string.lower(name), 1, true) == 1 then
			targetPlayer = plr
			break
		end
	end

	if not targetPlayer then
		warn("Joueur introuvable")
		return false
	end

	isFollowing = true
	followButton.Text = "Arrêter"
	followButton.BackgroundColor3 = Color3.fromRGB(220, 40, 40)

	connection = RunService.RenderStepped:Connect(function()
		if not isFollowing or not targetPlayer then
			stopFollowing()
			return
		end

		local targetChar = targetPlayer.Character
		local localChar = localPlayer.Character
		if not targetChar or not localChar then return end

		local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
		local localRoot = localChar:FindFirstChild("HumanoidRootPart")
		local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
		local localHum = localChar:FindFirstChildOfClass("Humanoid")

		if not (targetRoot and localRoot and targetHum and localHum) then return end

		-- Anti-siège
		if localHum.Sit or localHum:GetState() == Enum.HumanoidStateType.Seated then
			localHum.Sit = false
		end

		-- Suivi avec le décalage du slider
		local offset = CFrame.new(0, 0, currentOffset)
		localRoot.CFrame = targetRoot.CFrame * offset
		localRoot.AssemblyLinearVelocity = targetRoot.AssemblyLinearVelocity

		-- Saut automatique
		local state = targetHum:GetState()
		if state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall then
			localHum.Jump = true
		end
	end)

	return true
end

followButton.MouseButton1Click:Connect(function()
	if isFollowing then
		stopFollowing()
	else
		local name = textBox.Text
		if name == "" then return end
		startFollowing(name)
	end
end)

UserInputService.InputBegan:Connect(function(input, gp)
	if input.KeyCode == Enum.KeyCode.Escape then
		stopFollowing()
		screenGui:Destroy()
	end
end)
